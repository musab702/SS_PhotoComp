{
  "name": "ss-photocomp",
  "version": "0.0.0",
  "private": true,
  "description": "Daily photo competition app - Express/TypeScript API + Angular client",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run start --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspace server",
    "test": "npm run test --workspace client",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
